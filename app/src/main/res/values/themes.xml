<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Day/Night Adaptive) -->
    <style name="Theme.Vehiclefix" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar and navigation bar color. -->
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:windowAnimationStyle">@style/PitstopNoWindowAnimation</item>
    </style>

    <!-- Smooth Zero-Flicker Window Transition Style -->
    <style name="PitstopNoWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/no_anim</item>
        <item name="android:windowEnterAnimation">@anim/no_anim</item>
        <item name="android:windowExitAnimation">@anim/no_anim</item>
    </style>

    <!-- Subtle Minimalist Card Style -->
    <style name="TechCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Minimalist Capsule Card -->
    <style name="PinterestCapsule" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Emergency Button Style -->
    <style name="EmergencyButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/emergency_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Primary Minimalist Button Style -->
    <style name="PrimaryTechButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Protruding High-Legibility Typography Styles -->
    <style name="TypographyHeadline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TypographySubhead">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TypographyMetric">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>